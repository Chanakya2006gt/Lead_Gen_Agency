# =========================================================================
# Database Configuration (Supabase PostgreSQL or Local SQLite)
# =========================================================================

# For Supabase (Production Cloud):
# 1. Go to Supabase -> Project Settings -> Database -> Connection string (URI)
# 2. Set DATABASE_MODE=postgres and paste your Supabase connection string below:
# DATABASE_MODE=postgres
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# For Local SQLite (Default / Zero-Config):
DATABASE_MODE=sqlite
DATABASE_URL=./lead_engine.db

# Optional Supabase Client Keys (If using Supabase Auth or Realtime)
# NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: SerpAPI Key (Google Maps API)
SERPAPI_API_KEY=

# Optional: Apify Google Maps Scraper Actor API Token
APIFY_API_TOKEN=

# Optional: Outscraper API Key
OUTSCRAPER_API_KEY=

# Optional: OpenAI API Key (If omitted, system uses 100% deterministic grounded synthesis)
OPENAI_API_KEY=

# Optional: Port override
PORT=3000
