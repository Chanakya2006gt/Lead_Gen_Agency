# =========================================================================
# Agency Identity & Operator Customization (Used in Outreach Script Generation)
# =========================================================================
NEXT_PUBLIC_AGENCY_FOUNDER_NAME=Your Name
NEXT_PUBLIC_AGENCY_NAME=Your Agency Name
NEXT_PUBLIC_AGENCY_EMAIL=you@youragency.com
NEXT_PUBLIC_AGENCY_PHONE=+1 (555) 000-0000

# =========================================================================
# Workstation Authentication & Security
# =========================================================================
# Required in production. Shared workstation secret.
LEAD_ENGINE_API_SECRET=

# Dev-only. If true AND NODE_ENV is not "production", API routes allow unauthenticated access.
# Never set this in production.
ALLOW_INSECURE_LOCAL_AUTH=true

# Required to select source "live_google_maps". Default off.
ALLOW_UNSAFE_MAPS_SCRAPE=false

# Playwright Chromium --no-sandbox. CI may set this to true. Default false.
PLAYWRIGHT_NO_SANDBOX=false

# =========================================================================
# Database Configuration (Local SQLite Workstation Storage)
# =========================================================================
# SQLite only. Postgres/Supabase runtime is not implemented.
DATABASE_URL=.Postgres

# Official Google Maps Platform / Places API Key (Recommended for Direct Google Access):
# Get key from Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API Key
# (Ensure "Places API" or "Places API (New)" is enabled in APIs & Services -> Library)
GOOGLE_MAPS_API_KEY=

# Optional: SerpAPI Key (Google Maps API)
SERPAPI_API_KEY=

# Optional: Apify Google Maps Scraper Actor API Token
APIFY_API_TOKEN=

# Optional: Outscraper API Key
OUTSCRAPER_API_KEY=

# Optional: OpenAI Configuration (For AI-Enhanced Pitch Synthesis & Cold Outreach Generation)
# If omitted, system runs on 100% deterministic, zero-cost grounded rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Port override
PORT=3000
